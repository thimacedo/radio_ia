# CONFIGURAÇÕES DO SISTEMA RÁDIO IA - ESTÚDIO TJRN / NJUD
# Copie este arquivo como '.env' e ajuste os caminhos e chaves para a máquina local

# --- CHAVES DE API DO FALLBACK LLM ---
GROQ_API_KEY=sua_chave_aqui
DEEPSEEK_API_KEY=sua_chave_aqui
MISTRAL_API_KEY=sua_chave_aqui
OPENROUTER_API_KEY=sua_chave_aqui
OPENAI_API_KEY=sua_chave_aqui
GEMINI_API_KEY=sua_chave_aqui

# --- URL DO APP SCRIPT DE INTEGRAÇÃO COM PLANILHA ---
BOLETINS_WEBAPP_URL=sua_url_webapp_aqui

# --- CAMINHOS DE DRIVES E REPOSITÓRIOS ---
# Ajuste conforme a letra da unidade de disco mapeada para o Google Drive na máquina
DRIVE_ROOT_PATH=H:/Meu Drive/RADIO TJRN CONTEÚDO

# Caminho específico de controle dos Boletins
DRIVE_BOLETINS_DIR=H:/Meu Drive/RADIO TJRN CONTEÚDO/00_PRODUCAO_2026/07_MODELOS_TUTORIAIS

# Caminho específico de saída do Giro nas Comarcas
DRIVE_GIRO_OUTPUT_DIR=H:/Meu Drive/RADIO TJRN CONTEÚDO/PROGRAMAS/PROGRAMA GIRO NAS COMARCAS (10min)

# Caminhos específicos de entrada e saída do Notícias do Judiciário (NJUD)
DRIVE_NJUD_INPUT_DIR=H:/Meu Drive/RADIO TJRN CONTEÚDO/NOT JUDICIARIO (5 MIN)/NJUD 2026/Roteiros TXT Original
DRIVE_NJUD_OUTPUT_DIR=H:/Meu Drive/RADIO TJRN CONTEÚDO/NOT JUDICIARIO (5 MIN)/NJUD 2026
VOICE_AGENT_URL=http://127.0.0.1:8002
